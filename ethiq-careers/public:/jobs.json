fetch('https://api.recruitwithatlas.com/api/v1/projects?per_page=10', {
  headers: {
    'Authorization': 'hEVpFYwRHUKIymDhRyedzB',
    'Content-Type': 'application/json'
  }
})
.then(response => response.json())
.then(data => {
  const jobs = (data.data || []).map(job => ({
    id: job.id,
    title: job.jobRole,
    company: 'Confidential Client',
    location: job.location || { name: 'Location TBD' },
    salary: job.salary || 'Competitive salary',
    contractType: job.contractType || 'full_time',
    workMode: job.workMode || 'hybrid',
    seniority: job.seniority || 'senior',
    function: job.func || 'Various',
    summary: job.jobDescription ? job.jobDescription.substring(0, 200) + '...' : 'Exciting opportunity to join our client.',
    createdAt: job.createdAt || new Date().toISOString(),
    applyUrl: `https://api.recruitwithatlas.com/jobs/${job.id}`
  }));
  
  const finalJSON = {
    jobs: jobs,
    lastUpdated: new Date().toISOString(),
    count: jobs.length
  };
  
  console.log('=== COPY THIS JSON BELOW ===');
  console.log(JSON.stringify(finalJSON, null, 2));
  console.log('=== COPY THIS JSON ABOVE ===');
});
