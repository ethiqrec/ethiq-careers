# Atlas CRM
ATLAS_API_KEY=
ATLAS_BASE_URL=https://api.recruitwithatlas.com

# Anthropic (for LLM job description rewrites)
ANTHROPIC_API_KEY=

# Fallback email if a project's owner.email is missing
OWNER_EMAIL_FALLBACK=james@ethiqrec.com

# Resend (transactional email)
EMAIL_PROVIDER_KEY=

# Vercel Blob (CV uploads) — auto-set when you provision Blob storage
BLOB_READ_WRITE_TOKEN=

# Vercel KV (LLM cache) — auto-set when you provision KV
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Optional: protect /api/sync endpoint
CRON_SECRET=

